# ─── Server ───────────────────────────────────────────────────────────────────
# Use "live" for production keys / real money. Use "test" for sandbox.
ENV=test
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
PRETTY=true
# trace | debug | info | warn | error
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
# Runtime connection. Use the least-privilege role created by
# deploy/postgres/initdb (it cannot UPDATE/DELETE/TRUNCATE the ledger or audit log).
DATABASE_URL=postgres://gateway_runtime:gateway_runtime_secret@localhost:5432/gateway_db?sslmode=disable
# Table owner, used only to run migrations. Defaults to DATABASE_URL.
MIGRATIONS_DATABASE_URL=postgres://gateway:gateway_secret@localhost:5432/gateway_db?sslmode=disable
MIGRATIONS_PATH=file://migrations

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Chapa ────────────────────────────────────────────────────────────────────
CHAPA_SECRET_KEY=CHAPUBK_TEST-REPLACE_ME

# ─── Telebirr ─────────────────────────────────────────────────────────────────
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=

# ─── Gateway ──────────────────────────────────────────────────────────────────
BASE_CALLBACK_URL=https://api.example.com
FEE_PERCENT=0.029

# Per-merchant rate limit, requests per minute on authed routes (sliding window).
RATE_LIMIT_PER_MERCHANT=600
# Per-client-IP limit on all routes.
IP_RATE_LIMIT_PER_MINUTE=200
# Take the client IP from X-Real-IP / X-Forwarded-For. Only behind a proxy that sets them.
TRUST_PROXY_HEADERS=false
# Cache successful API-key checks (bcrypt is ~230 ms). 0 disables.
AUTH_CACHE_TTL=30s

# HMAC secret used to sign webhooks WE deliver to merchant endpoints.
# Generate with: openssl rand -hex 32
OUTBOUND_WEBHOOK_SIGNING_SECRET=replace_me_with_a_long_random_value
