# ─── Server ───────────────────────────────────────────────────────────────────
# Use "live" for production keys / real money. Use "test" for sandbox.
ENV=test
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
PRETTY=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gateway:gateway_secret@localhost:5432/gateway_db?sslmode=disable
MIGRATIONS_PATH=file://migrations

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ─── Chapa ────────────────────────────────────────────────────────────────────
CHAPA_SECRET_KEY=CHAPUBK_TEST-REPLACE_ME

# ─── Telebirr ─────────────────────────────────────────────────────────────────
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=

# ─── Gateway ──────────────────────────────────────────────────────────────────
BASE_CALLBACK_URL=https://api.example.com
FEE_PERCENT=0.029

# Per-merchant rate limit, requests per minute on authed routes.
RATE_LIMIT_PER_MERCHANT=600

# HMAC secret used to sign webhooks WE deliver to merchant endpoints.
# Generate with: openssl rand -hex 32
OUTBOUND_WEBHOOK_SIGNING_SECRET=replace_me_with_a_long_random_value
